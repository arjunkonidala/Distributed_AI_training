# graph.py

from langgraph.graph import StateGraph, START, END

from state import AgentState
from agents.intake import intake_agent
from agents.triage import triage_agent
from agents.safety import safety_and_rag_agent


def build_graph():

    graph = StateGraph(AgentState)

    graph.add_node(
        "intake",
        intake_agent
    )

    graph.add_node(
        "triage",
        triage_agent
    )

    graph.add_node(
        "rag_safety",
        safety_and_rag_agent
    )

    graph.add_edge(
        START,
        "intake"
    )

    graph.add_edge(
        "intake",
        "triage"
    )

    graph.add_edge(
        "triage",
        "rag_safety"
    )

    graph.add_edge(
        "rag_safety",
        END
    )

    return graph.compile()
